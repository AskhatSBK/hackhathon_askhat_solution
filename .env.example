# =============================================================================
# LLM  —  change LLM_PROVIDER to switch inference backend
# =============================================================================

# Provider: oss | gemini
LLM_PROVIDER=oss

# Model override (leave blank to use provider default):
#   oss    → oss-120b
#   gemini → gemini-2.5-flash
# LLM_MODEL=

# ── OSS (DataSaur competition API, default) ───────────────────────────────────
GPT_OSS_BASE_URL=https://your-oss-endpoint/v1
GPT_OSS_API_KEY=your-oss-api-key

# ── Gemini (Google AI Studio) ─────────────────────────────────────────────────
# Set LLM_PROVIDER=gemini above, then fill in:
# GOOGLE_AI_API_KEY=your-google-ai-studio-api-key


# =============================================================================
# EMBEDDING  —  change EMBED_PROVIDER to switch inference backend
# =============================================================================

# Provider: local | llama-cpp | ollama | openai | together | runpod | custom
EMBED_PROVIDER=llama-cpp

# ── llama-cpp (GGUF model via llama-cpp-python, runs in-process) ──────────────
# Download the model first:  python scripts/download_model.py
EMBED_MODEL_PATH=data/models/Qwen3-Embedding-0.6B-Q4_K_M.gguf
# EMBED_N_THREADS=8      # CPU threads (default: all cores)
# EMBED_N_CTX=2048       # context window in tokens

# ── ollama (Ollama native /api/embed, no OpenAI compat needed) ───────────────
# EMBED_PROVIDER=ollama
# EMBED_MODEL=qwen3-embedding:0.6b
# EMBED_BASE_URL=http://host.docker.internal:11434/api/embed

# ── local (sentence-transformers on CPU, default) ─────────────────────────────
# EMBED_PROVIDER=local
# EMBED_MODEL=Qwen/Qwen3-Embedding-0.6B
# No extra config needed. Model is downloaded automatically on first run.

# ── api (any OpenAI-compatible /v1/embeddings endpoint) ──────────────────────
# EMBED_PROVIDER=custom
# EMBED_BASE_URL=http://embed:8000/v1          # local vLLM / ROCm container
# EMBED_API_KEY=placeholder                    # use real key for external services
# EMBED_MODEL=Qwen/Qwen3-Embedding-0.6B

# ROCm GPU version (only needed for the local embed container):
# RDNA3   (RX 7xxx, Radeon 780M):  HSA_OVERRIDE_GFX_VERSION=11.0.0
# RDNA3.5 (Radeon 880M, 890M):     HSA_OVERRIDE_GFX_VERSION=11.0.1
# RDNA4   (RX 9xxx):               HSA_OVERRIDE_GFX_VERSION=12.0.0
# HSA_OVERRIDE_GFX_VERSION=11.0.1
